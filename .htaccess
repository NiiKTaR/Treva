<FilesMatch "^(config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_env.c>
    <Files "stream.php">
        SetEnv no-gzip 1
    </Files>
</IfModule>
DirectoryIndex index.php index.html
